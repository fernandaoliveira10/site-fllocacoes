generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProductCategory {
  PLATAFORMA_360
  CAMA_ELASTICA
  FOTOGRAFIA
  PISCINA_BOLINHA
  MESAS_CADEIRAS
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  role         String   @default("ADMIN")
  createdAt    DateTime @default(now())
}

model Product {
  id               String              @id @default(cuid())
  name             String
  description      String?
  category         ProductCategory
  basePricePerHour Int?
  isOutsourced     Boolean             @default(false)
  priceConfirmed   Boolean             @default(true)
  isActive         Boolean             @default(true)
  media            ProductMedia[]
  priceTiers       ProductPriceTier[]
  comboItems       ComboItem[]
  bookingItems     BookingItem[]
  extraPricePerHour Int?               // preço da hora extra após a duração do pacote
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
}

model ProductPriceTier {
  id            String  @id @default(cuid())
  productId     String
  product       Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  durationHours Int
  price         Int     // em centavos
  label         String?
  isComboPrice  Boolean @default(false)
}

model ProductMedia {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  type      String  @default("IMAGE")
}

model Combo {
  id            String      @id @default(cuid())
  name          String
  description   String?
  totalPrice    Int         // em centavos
  durationHours Int         @default(3)
  discountPct   Int?
  isActive      Boolean     @default(true)
  items         ComboItem[]
  bookings      Booking[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model ComboItem {
  id            String  @id @default(cuid())
  comboId       String
  combo         Combo   @relation(fields: [comboId], references: [id], onDelete: Cascade)
  productId     String
  product       Product @relation(fields: [productId], references: [id])
  quantity      Int     @default(1)
  durationHours Int?
}

model Booking {
  id              String        @id @default(cuid())
  clientName      String
  clientEmail     String
  clientPhone     String
  eventDate       DateTime
  eventTime       String
  durationHours   Int           @default(3)
  extraHours      Int           @default(0)
  comboId         String?
  combo           Combo?        @relation(fields: [comboId], references: [id])
  totalAmount     Int           // em centavos
  depositAmount   Int           // 30% do total
  paymentPlan     String        @default("deposit")
  paymentMethod   String        @default("pix")
  status          String        @default("PENDING")
  notes           String?
  eventType       String?       // tipo de evento: aniversário, casamento, etc.
  eventAddress    String        // endereço do evento
  eventCity       String?       // cidade do evento
  eventNotes      String?       // observações / detalhes adicionais
  transportFee    Int?          // taxa de locomoção em centavos (calculada depois)
  hasTransportFee Boolean       @default(false) // se há taxa pendente
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  items           BookingItem[]
}

model BookingItem {
  id            String  @id @default(cuid())
  bookingId     String
  booking       Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  productId     String
  product       Product @relation(fields: [productId], references: [id])
  quantity      Int     @default(1)
  price         Int     // snapshot do preço no momento
  durationHours Int     @default(3)
}
